rules_version = '2';

// Banco compartilhado do cardápio, sem login.
// Tudo fica em casas/{codigo}/...: só quem sabe o código da casa lê e grava.
// O código vale se existir o documento chaves/{codigo}, criado à mão no console.
// A coleção chaves não tem regra, então ninguém lê, lista nem cria códigos pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    function casaValida(codigo) {
      return exists(/databases/$(database)/documents/chaves/$(codigo));
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function lista(v, min, max) {
      return v is list && v.size() >= min && v.size() <= max;
    }

    function receitaOk(d) {
      return d.keys().hasAll(['nome', 'cat', 'tempo', 'rende', 'ingredientes', 'passos'])
        && d.keys().hasOnly(['nome', 'cat', 'tempo', 'rende', 'ingredientes', 'passos', 'dica', 'criadoEm'])
        && texto(d.nome, 1, 80)
        && d.cat in ['bases', 'proteinas', 'acompanhamentos', 'especiais', 'sucos', 'variar']
        && texto(d.tempo, 1, 40)
        && texto(d.rende, 1, 40)
        && lista(d.ingredientes, 1, 60)
        && lista(d.passos, 1, 40)
        && (!('dica' in d) || texto(d.dica, 0, 500))
        && (!('criadoEm' in d) || d.criadoEm is number);
    }

    // Prato trocado de um dia do ciclo: id "semana-dia", semana 0–1 e dia 0–4.
    function diaOk(id, d) {
      return id.matches('^[01]-[0-4]$')
        && d.keys().hasAll(['itens', 'vespera'])
        && d.keys().hasOnly(['itens', 'vespera'])
        && lista(d.itens, 1, 8)
        && texto(d.vespera, 0, 300);
    }

    match /casas/{codigo}/receitas/{id} {
      allow read, delete: if casaValida(codigo);
      allow create, update: if casaValida(codigo) && receitaOk(request.resource.data);
    }

    match /casas/{codigo}/dias/{id} {
      allow read, delete: if casaValida(codigo);
      allow create, update: if casaValida(codigo) && diaOk(id, request.resource.data);
    }
  }
}
